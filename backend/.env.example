# ── App ─────────────────────────────────────────────
# Product name shown in Swagger and the browser tab
APP_NAME=Graeville POS
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API (the Angular dev server)
CORS_ORIGINS=http://localhost:4200
# Timezone used for "today", order numbers and report date ranges
APP_TIMEZONE=Africa/Lagos

# ── Database (PostgreSQL) ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=graeville_pos
DB_LOGGING=false

# ── Auth ────────────────────────────────────────────
# Use a long random string: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Password given to users created without one (the Laravel app used 123456)
DEFAULT_USER_PASSWORD=ChangeMe123

# ── Seed (first Super Admin) ────────────────────────
SEED_ADMIN_EMAIL=admin@graeville.com
SEED_ADMIN_PASSWORD=password1!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# ── Store details (first-run defaults) ──────────────
# Used only to create the store settings the first time the API starts.
# After that, change them in the app: Administration → Store settings (no restart needed).
STORE_NAME=Mecca Beauty
STORE_ADDRESS=12 Admiralty Way, Lekki Phase 1, Lagos
STORE_PHONE=0800 000 0000
STORE_EMAIL=hello@meccabeauty.ng
STORE_RECEIPT_FOOTER=Thank you for shopping with us!
STORE_CURRENCY=NGN

# ── Mail (receipt emails). Leave MAIL_HOST empty to log emails to the console instead ──
MAIL_HOST=
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Graeville POS <no-reply@graeville.com>"

# ── Online sync (optional) ──────────────────────────
# On a shop (local) install: the base URL of the online server's API, e.g. https://stores.example.com/api
SYNC_REMOTE_URL=
# Shared secret. Must be identical on the local install and the online server.
SYNC_API_KEY=
# Push/pull every minute automatically (the Laravel scheduler did this)
SYNC_CRON_ENABLED=false
